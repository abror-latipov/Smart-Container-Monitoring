# Copy this file to .env and fill in real values before running Docker Compose.

# InsForge / BaaS
INSFORGE_URL=https://your-app.region.insforge.app
INSFORGE_ANON_KEY=replace_with_insforge_anon_key
INSFORGE_DATABASE_URL=postgresql://postgres:replace_with_password@your-db-host:5432/insforge

# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_CONTAINER_MAP=1:001,2:002,3:003

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id

# Frontend Vite env
VITE_INSFORGE_URL=https://your-app.region.insforge.app
VITE_INSFORGE_ANON_KEY=replace_with_insforge_anon_key
